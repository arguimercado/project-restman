# Clerk publishable key (https://dashboard.clerk.com > API keys). Safe to expose to the renderer.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Where the desktop app sends API requests. Point this at your deployed apps/api, or leave the
# default to test against a local `pnpm --filter @restman/api dev` server.
VITE_API_URL=http://localhost:4000/api
